{
  "name": "masoom",
  "version": "0.1.0",
  "private": true,
  "description": "Masoom Hardware ERP + Website monorepo",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev:db": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:api": "npm --workspace @masoom/backend run dev",
    "dev:web": "npm --workspace @masoom/frontend run dev",
    "build": "npm --workspaces run build --if-present",
    "typecheck": "npm --workspaces run typecheck --if-present",
    "seed": "npm --workspace @masoom/backend run seed",
    "migrate": "npm --workspace @masoom/backend run prisma:migrate",
    "studio": "npm --workspace @masoom/backend run prisma:studio"
  },
  "engines": {
    "node": ">=20"
  }
}
