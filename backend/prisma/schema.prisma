// Masoom Hardware — Prisma schema
// Money columns are Decimal(14,2). All FKs default to onDelete: Restrict for financial entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // SUPER_ADMIN, ADMIN, ACCOUNTANT, SALESMAN, WAREHOUSE, CUSTOMER
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted

  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "invoice.create", "product.delete"
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "invoice.create"
  entity    String // e.g. "Invoice"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPANY SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model CompanySettings {
  id             String   @id @default(cuid())
  legalName      String
  tradeName      String?
  trn            String // UAE 15-digit Tax Registration Number
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  country        String   @default("United Arab Emirates")
  logoUrl        String?
  defaultVatRate Decimal  @default(5.00) @db.Decimal(5, 2)
  invoiceFooter  String?
  bankDetails    Json?
  updatedAt      DateTime @updatedAt

  @@map("company_settings")
}

model DocumentSequence {
  id        String   @id @default(cuid())
  prefix    String // QT, SO, INV, DO, LPO, CN, DN, RV, PV
  year      Int // 2-digit short year, e.g. 26
  lastNum   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, year])
  @@map("document_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMERS / SUPPLIERS
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  legalName      String?
  trn            String?
  email          String?
  phone          String?
  contactPerson  String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  country        String  @default("United Arab Emirates")
  creditLimit    Decimal @default(0) @db.Decimal(14, 2)
  creditDays     Int     @default(0)
  openingBalance Decimal @default(0) @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean @default(true)

  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  deliveryOrders DeliveryOrder[]
  creditNotes    CreditNote[]
  payments       Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([phone])
  @@index([trn])
  @@map("customers")
}

model Supplier {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  legalName      String?
  trn            String?
  email          String?
  phone          String?
  contactPerson  String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  country        String  @default("United Arab Emirates")
  creditDays     Int     @default(0)
  openingBalance Decimal @default(0) @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean @default(true)

  lpos             Lpo[]
  purchaseInvoices PurchaseInvoice[]
  debitNotes       DebitNote[]
  payments         Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]

  @@map("brands")
}

model Product {
  id           String    @id @default(cuid())
  sku          String    @unique
  barcode      String?   @unique
  name         String
  description  String?
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  brandId      String?
  brand        Brand?    @relation(fields: [brandId], references: [id])
  unit         String    @default("PCS") // PCS, BOX, KG, M, BAG, ...
  costPrice    Decimal   @default(0) @db.Decimal(14, 2)
  sellingPrice Decimal   @default(0) @db.Decimal(14, 2)
  vatRate      Decimal   @default(5.00) @db.Decimal(5, 2)
  reorderLevel Int       @default(0)
  isActive     Boolean   @default(true)
  weightKg     Decimal?  @db.Decimal(10, 3)

  images      ProductImage[]
  attachments ProductAttachment[]
  inventory   InventoryItem[]
  stockLogs   StockLog[]

  quotationItems       QuotationItem[]
  salesOrderItems      SalesOrderItem[]
  invoiceItems         InvoiceItem[]
  deliveryOrderItems   DeliveryOrderItem[]
  creditNoteItems      CreditNoteItem[]
  lpoItems             LpoItem[]
  grnItems             GrnItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  debitNoteItems       DebitNoteItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
  position  Int     @default(0)

  @@map("product_images")
}

model ProductAttachment {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  label     String?

  @@map("product_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  address  String?
  city     String?
  isActive Boolean @default(true)

  inventory      InventoryItem[]
  stockLogs      StockLog[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  deliveryOrders DeliveryOrder[]
  grns           Grn[]

  @@map("warehouses")
}

model InventoryItem {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_items")
}

enum StockLogType {
  OPENING
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  RETURN_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGE
}

model StockLog {
  id          String       @id @default(cuid())
  type        StockLogType
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  qtyDelta    Decimal      @db.Decimal(14, 3) // signed
  refTable    String? // e.g. "DeliveryOrder"
  refId       String?
  notes       String?
  createdBy   String?
  createdAt   DateTime     @default(now())

  @@index([productId, warehouseId, createdAt])
  @@index([refTable, refId])
  @@map("stock_logs")
}

model StockTransfer {
  id              String              @id @default(cuid())
  number          String              @unique
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  date            DateTime            @default(now())
  notes           String?
  items           StockTransferItem[]
  createdBy       String?
  createdAt       DateTime            @default(now())

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  quantity   Decimal       @db.Decimal(14, 3)

  @@map("stock_transfer_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALES — Quotation, Sales Order, Invoice, Delivery Order, Credit Note
// ─────────────────────────────────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  PART_PAID
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Quotation {
  id         String          @id @default(cuid())
  number     String          @unique
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  date       DateTime        @default(now())
  validUntil DateTime?
  status     QuotationStatus @default(DRAFT)
  notes      String?
  terms      String?

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  vatAmount     Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  vatBreakdown  Json?

  items      QuotationItem[]
  salesOrder SalesOrder?
  pdfUrl     String?
  createdBy  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([customerId, date])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal   @db.Decimal(14, 3)
  unitPrice   Decimal   @db.Decimal(14, 2)
  discount    Decimal   @default(0) @db.Decimal(14, 2)
  vatRate     Decimal   @default(5.00) @db.Decimal(5, 2)
  subtotal    Decimal   @db.Decimal(14, 2)
  vatAmount   Decimal   @db.Decimal(14, 2)
  total       Decimal   @db.Decimal(14, 2)
  position    Int       @default(0)

  @@map("quotation_items")
}

model SalesOrder {
  id          String           @id @default(cuid())
  number      String           @unique
  quotationId String?          @unique
  quotation   Quotation?       @relation(fields: [quotationId], references: [id])
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  date        DateTime         @default(now())
  status      SalesOrderStatus @default(DRAFT)
  notes       String?

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  vatAmount     Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  vatBreakdown  Json?

  items     SalesOrderItem[]
  invoice   Invoice?
  pdfUrl    String?
  createdBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([customerId, date])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  description  String?
  quantity     Decimal    @db.Decimal(14, 3)
  unitPrice    Decimal    @db.Decimal(14, 2)
  discount     Decimal    @default(0) @db.Decimal(14, 2)
  vatRate      Decimal    @default(5.00) @db.Decimal(5, 2)
  subtotal     Decimal    @db.Decimal(14, 2)
  vatAmount    Decimal    @db.Decimal(14, 2)
  total        Decimal    @db.Decimal(14, 2)
  position     Int        @default(0)

  @@map("sales_order_items")
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  salesOrderId String?       @unique
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  date         DateTime      @default(now())
  dueDate      DateTime?
  status       InvoiceStatus @default(DRAFT)
  notes        String?
  terms        String?

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  vatAmount     Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal @default(0) @db.Decimal(14, 2)
  vatBreakdown  Json?

  items              InvoiceItem[]
  deliveryOrders     DeliveryOrder[]
  creditNotes        CreditNote[]
  paymentAllocations PaymentAllocation[]

  pdfUrl    String?
  qrPayload String? // FTA TLV string used for the QR
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postedAt  DateTime?

  @@index([customerId, date])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  vatRate     Decimal @default(5.00) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(14, 2)
  vatAmount   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  position    Int     @default(0)

  @@map("invoice_items")
}

model DeliveryOrder {
  id              String         @id @default(cuid())
  number          String         @unique
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  date            DateTime       @default(now())
  status          DeliveryStatus @default(DRAFT)
  deliveryAddress String?
  driverName      String?
  vehicleNo       String?
  notes           String?

  items     DeliveryOrderItem[]
  pdfUrl    String?
  createdBy String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([customerId, date])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  description     String?
  quantity        Decimal       @db.Decimal(14, 3)
  position        Int           @default(0)

  @@map("delivery_order_items")
}

model CreditNote {
  id         String   @id @default(cuid())
  number     String   @unique
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  date       DateTime @default(now())
  reason     String?
  notes      String?

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  vatAmount     Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  vatBreakdown  Json?

  items     CreditNoteItem[]
  pdfUrl    String?
  createdBy String?
  createdAt DateTime         @default(now())

  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  description  String?
  quantity     Decimal    @db.Decimal(14, 3)
  unitPrice    Decimal    @db.Decimal(14, 2)
  vatRate      Decimal    @default(5.00) @db.Decimal(5, 2)
  subtotal     Decimal    @db.Decimal(14, 2)
  vatAmount    Decimal    @db.Decimal(14, 2)
  total        Decimal    @db.Decimal(14, 2)
  restoreStock Boolean    @default(false)
  position     Int        @default(0)

  @@map("credit_note_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PURCHASES — LPO, GRN, Purchase Invoice, Debit Note
// ─────────────────────────────────────────────────────────────────────────────

enum LpoStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PAID
  PART_PAID
  CANCELLED
}

model Lpo {
  id         String    @id @default(cuid())
  number     String    @unique
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  date       DateTime  @default(now())
  status     LpoStatus @default(DRAFT)
  notes      String?

  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  vatAmount Decimal @default(0) @db.Decimal(14, 2)
  total     Decimal @default(0) @db.Decimal(14, 2)

  items     LpoItem[]
  grns      Grn[]
  pdfUrl    String?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([supplierId, date])
  @@map("lpos")
}

model LpoItem {
  id          String  @id @default(cuid())
  lpoId       String
  lpo         Lpo     @relation(fields: [lpoId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  vatRate     Decimal @default(5.00) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(14, 2)
  vatAmount   Decimal @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  position    Int     @default(0)

  @@map("lpo_items")
}

model Grn {
  id          String    @id @default(cuid())
  number      String    @unique
  lpoId       String?
  lpo         Lpo?      @relation(fields: [lpoId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  date        DateTime  @default(now())
  notes       String?

  items     GrnItem[]
  createdBy String?
  createdAt DateTime  @default(now())

  @@map("grns")
}

model GrnItem {
  id        String  @id @default(cuid())
  grnId     String
  grn       Grn     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
  unitCost  Decimal @db.Decimal(14, 2)

  @@map("grn_items")
}

model PurchaseInvoice {
  id                String                @id @default(cuid())
  number            String                @unique
  supplierInvoiceNo String?
  supplierId        String
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  date              DateTime              @default(now())
  dueDate           DateTime?
  status            PurchaseInvoiceStatus @default(DRAFT)
  notes             String?

  subtotal     Decimal @default(0) @db.Decimal(14, 2)
  vatAmount    Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @default(0) @db.Decimal(14, 2)
  amountPaid   Decimal @default(0) @db.Decimal(14, 2)
  vatBreakdown Json?

  items              PurchaseInvoiceItem[]
  debitNotes         DebitNote[]
  paymentAllocations PaymentAllocation[]
  pdfUrl             String?
  createdBy          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  postedAt           DateTime?

  @@index([supplierId, date])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  description       String?
  quantity          Decimal         @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(14, 2)
  vatRate           Decimal         @default(5.00) @db.Decimal(5, 2)
  subtotal          Decimal         @db.Decimal(14, 2)
  vatAmount         Decimal         @db.Decimal(14, 2)
  total             Decimal         @db.Decimal(14, 2)
  position          Int             @default(0)

  @@map("purchase_invoice_items")
}

model DebitNote {
  id                String          @id @default(cuid())
  number            String          @unique
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  date              DateTime        @default(now())
  reason            String?
  total             Decimal         @default(0) @db.Decimal(14, 2)

  items     DebitNoteItem[]
  pdfUrl    String?
  createdBy String?
  createdAt DateTime        @default(now())

  @@map("debit_notes")
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(14, 3)
  unitCost    Decimal   @db.Decimal(14, 2)
  total       Decimal   @db.Decimal(14, 2)

  @@map("debit_note_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENTS  (works for both customer receipts and supplier payments)
// ─────────────────────────────────────────────────────────────────────────────

// RECEIVED from customer, PAID to supplier
enum PaymentDirection {
  RECEIVED
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  ONLINE
  OTHER
}

model Payment {
  id        String           @id @default(cuid())
  number    String           @unique
  direction PaymentDirection
  method    PaymentMethod
  date      DateTime         @default(now())
  amount    Decimal          @db.Decimal(14, 2)
  reference String?
  notes     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  allocations PaymentAllocation[]
  pdfUrl      String?
  createdBy   String?
  createdAt   DateTime            @default(now())

  @@index([customerId, date])
  @@index([supplierId, date])
  @@map("payments")
}

model PaymentAllocation {
  id                String           @id @default(cuid())
  paymentId         String
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId         String?
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id])
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  amount            Decimal          @db.Decimal(14, 2)

  @@index([invoiceId])
  @@index([purchaseInvoiceId])
  @@map("payment_allocations")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACCOUNTS — minimal journal model for Phase 4
// ─────────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id       String        @id @default(cuid())
  code     String        @unique
  name     String
  type     AccountType
  parentId String?
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]

  @@map("accounts")
}

model Journal {
  id        String        @id @default(cuid())
  number    String        @unique
  date      DateTime      @default(now())
  narration String?
  refTable  String?
  refId     String?
  lines     JournalLine[]
  createdBy String?
  createdAt DateTime      @default(now())

  @@index([refTable, refId])
  @@map("journals")
}

model JournalLine {
  id        String  @id @default(cuid())
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  notes     String?

  @@map("journal_lines")
}

model Expense {
  id            String         @id @default(cuid())
  number        String         @unique
  date          DateTime       @default(now())
  category      String
  description   String?
  amount        Decimal        @db.Decimal(14, 2)
  vatAmount     Decimal        @default(0) @db.Decimal(14, 2)
  total         Decimal        @db.Decimal(14, 2)
  paidVia       PaymentMethod?
  attachmentUrl String?
  createdBy     String?
  createdAt     DateTime       @default(now())

  @@index([date])
  @@map("expenses")
}
